+    # [wm-bench 0004] outlier inclusion of the paper (Sec. 4.3, Algorithm 1, Eq. (1))
+    def _select_outliers(self, row):
+        """Upper outliers of the row (IQR, Q1/Q3 = 25/75th percentile, fence Q3 + S * IQR) as in the
+        commented-out code of the repository: one outlier is included, of several half are chosen with
+        the key (np.random.choice seeded with hash_key, floor of half)."""
+        data = row.float().cpu().numpy()
+        q1 = np.percentile(data, 25)
+        q3 = np.percentile(data, 75)
+        upper_bound = q3 + self.outlier_scale * (q3 - q1)
+        outlier_indices = [int(i) for i in np.nonzero(data > upper_bound)[0]]
+        if len(outlier_indices) <= 1:
+            return outlier_indices, len(outlier_indices)
+        chosen = np.random.RandomState(self.hash_key).choice(outlier_indices, len(outlier_indices) // 2, replace=False)
+        return [int(i) for i in chosen], len(outlier_indices)
+
+    def _include_outliers(self, greenlist_mask, bit):
+        """Puts the selected outliers in the favoured part (green for bit 1, red for bit 0) at the
+        information positions only (Sec. 4.3: the error-correction bits are embedded without outliers).
+        The error-correction bit is set at the next step, from the sampled token (_finish_outlier_bit)."""
+        if self.outlier_scale is None or self.tele_count % 24 >= 12:
+            return greenlist_mask
+        moved = []
+        if self.selected_indices:
+            sel = torch.tensor(self.selected_indices, device=greenlist_mask.device, dtype=torch.long)
+            in_green = greenlist_mask[0, sel]
+            moved = (sel[~in_green] if bit == 1 else sel[in_green]).tolist()
+            greenlist_mask[0, sel] = bit == 1
+        self.outlier_pending = (self.tele_count, set(moved))
+        self.outlier_log.append({"position": self.tele_count, "bit": bit, "n_outliers": self.n_outliers,
+                                 "n_included": len(self.selected_indices), "n_moved": len(moved)})
+        return greenlist_mask
+
+    def _finish_outlier_bit(self, input_ids):
+        """Error-correction bit of the last information position: 1 if the sampled token is an included
+        outlier that the detector reads in the other part (Sec. 4.3), otherwise 0."""
+        if self.outlier_pending is None:
+            return
+        position, moved = self.outlier_pending
+        self.outlier_pending = None
+        hit = int(input_ids[-1][-1].item()) in moved
+        self.robust_list[position] = "1" if hit else "0"
+        self.outlier_log[-1]["sampled_moved"] = hit
+
 
 

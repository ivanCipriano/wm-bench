+class InProcessHFProvider(LLMProvider):
+    """[wm-bench 0001] Provider in-process (SPEC 9.4): Hugging Face model already loaded by the worker.
+
+    The prompt becomes a chat with the framework's fixed system prompt (or the given one), encoded with
+    ``apply_chat_template(add_generation_prompt=True)``; decoding comes from the framework's
+    ``generation_config`` (``max_tokens`` and ``temperature`` of the callers are ignored). ``seed_fn``,
+    if given, returns the seed to set before each generation.
+    """
+
+    def __init__(
+        self,
+        api_key: Optional[str] = None,
+        model=None,
+        tokenizer=None,
+        generation_config=None,
+        system_prompt: str = "",
+        device: str = "cuda:0",
+        seed_fn=None,
+    ):
+        super().__init__(api_key)
+        if model is None or tokenizer is None or generation_config is None:
+            raise ValueError("inprocess_hf needs model, tokenizer and generation_config")
+        self.model = model
+        self.tokenizer = tokenizer
+        self.generation_config = generation_config
+        self.system_prompt = system_prompt
+        self.device = device
+        self.seed_fn = seed_fn
+
+    def generate(
+        self,
+        prompt: str,
+        system_prompt: str = "",
+        max_tokens: int = 2048,
+        temperature: float = 0.1,
+    ) -> LLMResponse:
+        import torch
+
+        messages = [
+            {"role": "system", "content": system_prompt or self.system_prompt},
+            {"role": "user", "content": prompt},
+        ]
+        input_ids = self.tokenizer.apply_chat_template(
+            messages, add_generation_prompt=True, return_tensors="pt"
+        ).to(self.device)
+        if self.seed_fn is not None:
+            seed = int(self.seed_fn())
+            torch.manual_seed(seed)
+            if torch.cuda.is_available():
+                torch.cuda.manual_seed_all(seed)
+        with torch.no_grad():
+            output = self.model.generate(
+                input_ids=input_ids,
+                attention_mask=torch.ones_like(input_ids),
+                generation_config=self.generation_config,
+                num_return_sequences=1,
+            )
+        new_tokens = output[:, input_ids.shape[1]:]
+        text = self.tokenizer.batch_decode(new_tokens, skip_special_tokens=True)[0]
+        return LLMResponse(
+            text=text,
+            input_tokens=int(input_ids.shape[1]),
+            output_tokens=int(new_tokens.shape[1]),
+        )
+
+    def count_tokens(self, text: str) -> int:
+        return len(self.tokenizer.encode(text, add_special_tokens=False))
+
+    def validate_connection(self) -> bool:
+        return True
+
+
 class LLMProviderFactory:
     """Factory for creating LLM provider instances."""
     
